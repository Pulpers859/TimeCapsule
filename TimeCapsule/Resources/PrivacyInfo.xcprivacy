<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!--
            Two reasons, because the app makes two different kinds of
            UserDefaults access and each needs declaring.

            CA92.1 covers information accessible only to the app itself:
            NotificationManager's `UserDefaults.standard`, and the @AppStorage
            in SettingsView that has no explicit store.

            1C8F.1 covers the App Group suite in AtticDefaults, which the
            widget extension reads too. CA92.1 does not permit information
            reachable from outside the app, so declaring only CA92.1
            under-declares that half — and declaring only 1C8F.1 would
            under-declare the other. Both belong here.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
                <string>1C8F.1</string>
            </array>
        </dict>
        <!--
            sweepStaleShareExports() in MediaAssetLoading.swift reads
            contentModificationDateKey to age out share exports the app left in
            its own temporary directory. That key is on Apple's required-reason
            list, and an undeclared use is refused at upload, not at review.

            C617.1 is the reason for file metadata inside the app container,
            which is where TimeCapsuleShare/ lives. DDA9.1 would be wrong: no
            timestamp is ever shown to the user.

            Note this declaration is NOT for PHAsset.creationDate, which the app
            uses widely. The creationDate on Apple's list is
            FileAttributeKey.creationDate; the PhotoKit property is unrelated.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
    </array>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyTracking</key>
    <false/>
</dict>
</plist>
