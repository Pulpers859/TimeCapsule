#!/bin/sh

remote="${1:-origin}"
branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

if [ -z "$branch" ] || [ "$branch" != "dev" ]; then
  exit 0
fi

if [ "${TIMECAPSULE_ALLOW_DEV_ONLY_PUSH:-0}" = "1" ]; then
  exit 0
fi

default_ref="$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)"
default_branch="${default_ref#"$remote/"}"

if [ -z "$default_branch" ]; then
  default_branch="main"
fi

if ! git show-ref --verify --quiet "refs/heads/$default_branch"; then
  exit 0
fi

head_sha="$(git rev-parse HEAD)"

if git merge-base --is-ancestor "$head_sha" "$default_branch"; then
  exit 0
fi

cat >&2 <<EOF
Push blocked: you're pushing 'dev', but '$default_branch' does not include commit $head_sha yet.

This repo's default branch on GitHub is '$default_branch', so a normal pull from '$default_branch'
will miss these changes until you promote them.

Release flow:
  git checkout $default_branch
  git merge --ff-only dev
  git push $remote $default_branch
  git checkout dev

If you intentionally want a dev-only backup push, rerun with:
  TIMECAPSULE_ALLOW_DEV_ONLY_PUSH=1 git push $remote dev
EOF

exit 1
